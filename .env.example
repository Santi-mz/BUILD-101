# Copiá este archivo a .env.local y completá los valores (nunca lo subas a git).

# Gemini API (plan gratis): https://aistudio.google.com/apikey
# Sin clave, la app arranca en MODO DEMO: analizador por reglas y preguntas de plantilla (todo el flujo se puede recorrer).
GEMINI_API_KEY=
# Opcional: "mock" fuerza el modo demo aunque haya clave. LLM_MODEL fuerza el modelo de Gemini.
LLM_PROVIDER=
LLM_MODEL=

# Conectate con tu futuro: edad mínima sin consentimiento de un adulto (18 hasta revisión legal, Ley 18.331)
# y días que se guardan las sesiones antes de borrarse solas.
MIN_AGE=18
RETENTION_DAYS=30

# Supabase: Project Settings > API. Sin SUPABASE_SERVICE_ROLE_KEY las sesiones se guardan en memoria (solo para probar en local).
# STORE=memory fuerza la memoria.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cualquier string largo y aleatorio. Vercel Cron lo manda como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Opcional: sube el límite de PubMed de 3 a 10 req/s. https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
